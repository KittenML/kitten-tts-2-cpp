# wiring (L9a/L9b), post (L10), voices (L11 voices.kt2n), LM (L3), render backend (stub until L7).
#   kt2n_engine_policy   CPU: production's timing decisions as pure functions (src/engine/policy.*)
#   kt2n_engine          static: the runtime (needs CUDA for the L3 LM)
#   libkt2n_engine.so    shared: the C ABI
#   kt2n-say             CLI: text -> WAV, and the in-process bench driver (--bench N)
# Included at the end of the top-level CMakeLists.txt (every lane target exists by then).

if(KT2N_BUILD_TESTS)
  enable_testing()  # this file is included before the top-level enable_testing()
endif()

add_library(kt2n_engine_policy STATIC src/engine/policy.cc)
target_include_directories(kt2n_engine_policy PUBLIC "${PROJECT_SOURCE_DIR}/include" "${PROJECT_SOURCE_DIR}/src/engine")
target_link_libraries(kt2n_engine_policy PUBLIC kt2n_core)
target_compile_features(kt2n_engine_policy PUBLIC cxx_std_20)
set_target_properties(kt2n_engine_policy PROPERTIES POSITION_INDEPENDENT_CODE ON)
kt2n_set_warnings(kt2n_engine_policy)

if(KT2N_BUILD_TESTS)
  add_executable(test_engine_policy "${PROJECT_SOURCE_DIR}/tests/engine/policy_test.cc")
  target_link_libraries(test_engine_policy PRIVATE kt2n_engine_policy GTest::gtest_main)
  gtest_discover_tests(test_engine_policy DISCOVERY_MODE PRE_TEST PROPERTIES LABELS cpu)
endif()

if(KT2N_HAVE_CUDA)
  set(_kt2n_engine_sources src/engine/engine.cc src/engine/backends.cc src/engine/text_front.cc)
  if(TARGET kt2n_render_cuda)
    list(APPEND _kt2n_engine_sources src/engine/backend_l7.cu)
  endif()
  add_library(kt2n_engine_rt STATIC ${_kt2n_engine_sources})
  target_include_directories(kt2n_engine_rt PUBLIC "${PROJECT_SOURCE_DIR}/include"
    PRIVATE "${PROJECT_SOURCE_DIR}/src/engine" "${PROJECT_SOURCE_DIR}/src/voice" "${PROJECT_SOURCE_DIR}/src/core")
  target_link_libraries(kt2n_engine_rt PUBLIC kt2n_engine_policy kt2n_textplan kt2n_post kt2n_voice_blob kt2n_cuda
    Threads::Threads)
  if(TARGET kt2n_text)
    target_compile_definitions(kt2n_engine_rt PRIVATE KT2N_ENGINE_WITH_TEXT=1)
    target_include_directories(kt2n_engine_rt PRIVATE "${PROJECT_SOURCE_DIR}/src/text" "${KT2N_TEXT_DEPS}/include")
    target_link_libraries(kt2n_engine_rt PUBLIC kt2n_text)
  endif()
  if(TARGET kt2n_render_cuda)
    target_compile_definitions(kt2n_engine_rt PRIVATE KT2N_ENGINE_WITH_L7=1)
    target_link_libraries(kt2n_engine_rt PUBLIC kt2n_render_cuda)
    kt2n_cuda_target(kt2n_engine_rt)
  endif()
  if(TARGET kt2n_render_flow)  # the real renderer (L7 Renderer: L4 encoder + L5 estimator + L6 HiFT)
    target_compile_definitions(kt2n_engine_rt PRIVATE KT2N_ENGINE_WITH_RENDERER=1)
    target_link_libraries(kt2n_engine_rt PUBLIC kt2n_render_flow)
  endif()
  if(TARGET kt2n_voice_service)
    target_compile_definitions(kt2n_engine_rt PRIVATE KT2N_ENGINE_WITH_VOICE=1)
    target_link_libraries(kt2n_engine_rt PUBLIC kt2n_voice_service)
  endif()
  if(TARGET kt2n_encode)
    target_compile_definitions(kt2n_engine_rt PRIVATE KT2N_ENGINE_WITH_AV=1)
    target_link_libraries(kt2n_engine_rt PUBLIC kt2n_encode)
  endif()
  set_target_properties(kt2n_engine_rt PROPERTIES POSITION_INDEPENDENT_CODE ON LINKER_LANGUAGE CUDA)
  kt2n_set_warnings(kt2n_engine_rt)

  add_library(kt2n_engine SHARED ${_kt2n_engine_sources})
  if(KT2N_BUILD_TESTS)
    target_compile_definitions(kt2n_engine_rt PRIVATE KT2N_ALLOW_TEST_STUBS=1)
    target_compile_definitions(kt2n_engine PRIVATE KT2N_ALLOW_TEST_STUBS=1)
  endif()
  target_include_directories(kt2n_engine PUBLIC "${PROJECT_SOURCE_DIR}/include"
    PRIVATE "${PROJECT_SOURCE_DIR}/src/engine" "${PROJECT_SOURCE_DIR}/src/voice" "${PROJECT_SOURCE_DIR}/src/core")
  target_link_libraries(kt2n_engine PRIVATE kt2n_engine_policy kt2n_textplan kt2n_post kt2n_voice_blob kt2n_cuda
    Threads::Threads)
  if(TARGET kt2n_text)
    target_compile_definitions(kt2n_engine PRIVATE KT2N_ENGINE_WITH_TEXT=1)
    target_include_directories(kt2n_engine PRIVATE "${PROJECT_SOURCE_DIR}/src/text" "${KT2N_TEXT_DEPS}/include")
    target_link_libraries(kt2n_engine PRIVATE kt2n_text)
  endif()
  if(TARGET kt2n_render_cuda)
    target_compile_definitions(kt2n_engine PRIVATE KT2N_ENGINE_WITH_L7=1)
    target_link_libraries(kt2n_engine PRIVATE kt2n_render_cuda)
    kt2n_cuda_target(kt2n_engine)
  endif()
  if(TARGET kt2n_render_flow)
    target_compile_definitions(kt2n_engine PRIVATE KT2N_ENGINE_WITH_RENDERER=1)
    target_link_libraries(kt2n_engine PRIVATE kt2n_render_flow)
  endif()
  if(TARGET kt2n_voice_service)
    target_compile_definitions(kt2n_engine PRIVATE KT2N_ENGINE_WITH_VOICE=1)
    target_link_libraries(kt2n_engine PRIVATE kt2n_voice_service)
  endif()
  if(TARGET kt2n_encode)
    target_compile_definitions(kt2n_engine PRIVATE KT2N_ENGINE_WITH_AV=1)
    target_link_libraries(kt2n_engine PRIVATE kt2n_encode)
  endif()
  set_target_properties(kt2n_engine PROPERTIES LINKER_LANGUAGE CUDA C_VISIBILITY_PRESET hidden
    CXX_VISIBILITY_PRESET hidden LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib")
  target_link_options(kt2n_engine PRIVATE "LINKER:--exclude-libs,ALL")


  if(KT2N_BUILD_TESTS)
    add_executable(test_engine_runtime "${PROJECT_SOURCE_DIR}/tests/engine/runtime_test.cc")
    target_link_libraries(test_engine_runtime PRIVATE kt2n_engine_rt kt2n_voice_blob GTest::gtest_main)
    # L11's voices.kt2n writer for the voice-release test (a synthetic catalogue + saved voice).
    target_include_directories(test_engine_runtime PRIVATE "${PROJECT_SOURCE_DIR}/src/voice" "${PROJECT_SOURCE_DIR}/src/core")
    set_target_properties(test_engine_runtime PROPERTIES LINKER_LANGUAGE CUDA)
    gtest_discover_tests(test_engine_runtime DISCOVERY_MODE PRE_TEST PROPERTIES LABELS cpu)
  endif()
endif()

